# Wan2.1 T2V 1.3B weights — downloaded at container boot by start.sh (MANIFEST_URL).
# Lands in ComfyUI's native model folders (/comfyui/models/...) which it scans by default.
# HuggingFace resolve URLs redirect to short-lived signed CDN URLs; aria2 follows
# the redirect fresh at request time, so this works without baking weights into the image.

https://huggingface.co/Comfy-Org/Wan_2.1_ComfyUI_Repackaged/resolve/main/split_files/diffusion_models/wan2.1_t2v_1.3B_fp16.safetensors
  out=wan2.1_t2v_1.3B_fp16.safetensors
  dir=/comfyui/models/diffusion_models

https://huggingface.co/Comfy-Org/Wan_2.1_ComfyUI_Repackaged/resolve/main/split_files/vae/wan_2.1_vae.safetensors
  out=wan_2.1_vae.safetensors
  dir=/comfyui/models/vae

https://huggingface.co/Comfy-Org/Wan_2.1_ComfyUI_Repackaged/resolve/main/split_files/text_encoders/umt5_xxl_fp16.safetensors
  out=umt5_xxl_fp16.safetensors
  dir=/comfyui/models/text_encoders
